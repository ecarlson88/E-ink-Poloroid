# Copy to .env and fill in. Never commit .env.
# Long random value, also goes in firmware/magnet/secrets.h:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=
# From: docker compose run --rm magnet python -c "from app import hash_password; print(hash_password('your password'))"
# Escape every $ as $$ in this file (compose reads $ as a variable).
UPLOAD_PASSWORD_HASH=
# Long random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Optional: where low-battery alerts are POSTed as {"battery_mv": n}
LOW_BATTERY_WEBHOOK_URL=
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker install command: the long value after --token)
TUNNEL_TOKEN=
